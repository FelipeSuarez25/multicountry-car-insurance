{
  "kind": "collectionType",
  "collectionName": "form_fields",
  "info": {
    "singularName": "form-field",
    "pluralName": "form-fields",
    "displayName": "Campo del formulario",
    "description": "Un campo del paso 1 del cotizador, por país (US-01 spec 7.1, ADR-0001)."
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "key": {
      "type": "string",
      "required": true,
      "regex": "^[a-z][a-zA-Z0-9]*$"
    },
    "label": {
      "type": "string",
      "required": true,
      "minLength": 1
    },
    "type": {
      "type": "enumeration",
      "enum": ["text", "number", "select", "date", "checkbox"],
      "required": true
    },
    "isRequired": {
      "type": "boolean",
      "default": false,
      "required": true
    },
    "helpText": {
      "type": "text"
    },
    "placeholder": {
      "type": "string"
    },
    "errorMessage": {
      "type": "string",
      "required": true,
      "minLength": 1
    },
    "requiredMessage": {
      "type": "string"
    },
    "sortOrder": {
      "type": "integer",
      "required": true
    },
    "options": {
      "type": "component",
      "component": "form.select-option",
      "repeatable": true
    },
    "rules": {
      "type": "component",
      "component": "form.validation-rule",
      "repeatable": true
    },
    "country": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::country.country",
      "required": true
    }
  }
}
