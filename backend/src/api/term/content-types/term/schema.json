      "required": true,
      "minLength": 1,
      "maxLength": 150
    },
    "body": {
      "type": "blocks",
      "required": true
    },
    "country": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::country.country",
      "required": true
    }
  }
}
