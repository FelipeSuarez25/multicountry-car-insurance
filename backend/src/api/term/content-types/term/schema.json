{
  "kind": "collectionType",
  "collectionName": "terms",
  "info": {
    "singularName": "term",
    "pluralName": "terms",
    "displayName": "Términos y condiciones",
    "description": "Términos y condiciones del seguro mostrados en el resumen del cotizador, por país (US-03 spec 7.1, ADR-0009)."
