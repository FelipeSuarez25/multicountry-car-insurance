{
  "kind": "collectionType",
  "collectionName": "countries",
  "info": {
    "singularName": "country",
    "pluralName": "countries",
    "displayName": "País",
    "description": "Un país donde se vende el seguro (ADR-0001). Su código ISO es la clave natural."
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "code": {
      "type": "string",
      "required": true,
      "unique": true,
      "regex": "^[A-Z]{2}$",
      "minLength": 2,
      "maxLength": 2
    },
    "name": {
      "type": "string",
      "required": true
    },
    "currencyCode": {
      "type": "string",
      "required": true,
      "regex": "^[A-Z]{3}$"
    },
    "locale": {
      "type": "string",
      "required": true
    },
    "sortOrder": {
      "type": "integer",
      "required": true,
      "default": 0
    }
  }
}
