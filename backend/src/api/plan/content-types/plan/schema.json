{
  "kind": "collectionType",
  "collectionName": "plans",
  "info": {
    "singularName": "plan",
    "pluralName": "plans",
    "displayName": "Plan",
    "description": "Un plan de seguro ofrecido en el paso 2 del cotizador, por país (US-02 spec 7.1, ADR-0001)."
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "key": {
      "type": "string",
      "required": true,
      "regex": "^[a-z][a-z0-9-]*$"
    },
    "name": {
      "type": "string",
      "required": true,
      "minLength": 1
    },
    "shortDescription": {
      "type": "string",
      "required": true,
      "minLength": 1,
      "maxLength": 200
    },
    "basePrice": {
      "type": "integer",
      "required": true,
      "min": 1,
      "max": 2147483647
    },
    "sortOrder": {
      "type": "integer",
      "required": true
    },
    "isRecommended": {
      "type": "boolean",
      "default": false
    },
    "isActive": {
      "type": "boolean",
      "default": true
    },
    "coverages": {
      "type": "component",
      "component": "plan.coverage",
      "repeatable": true,
      "min": 1
    },
    "benefits": {
      "type": "component",
      "component": "plan.benefit",
      "repeatable": true
    },
    "country": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::country.country",
      "required": true
    }
  }
}
